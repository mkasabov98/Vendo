# Server
PORT=3000
NODE_ENV=dev

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=

# Set to "true" to run sequelize.sync({ alter: true }) on boot.
# Use on first prod boot to create tables, then unset.
DB_SYNC=true

# Auth
JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
# In production, get this from the Stripe Dashboard webhook endpoint settings.
# In local dev, use STRIPE_LOCAL_WEBHOOK_SECRET from the Stripe CLI instead.
STRIPE_WEBHOOK_SECRET=
STRIPE_LOCAL_WEBHOOK_SECRET=

# Email (Gmail SMTP — requires a Google App Password, not your account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:4200
